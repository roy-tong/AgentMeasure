{
  "spec_version": "agentmeasure-0.4",
  "family": "DELEGATION Multi-Agent Audit",
  "description": "Delegation conformance checks for multi-agent delegation audit (CORE 0.4.5).",
  "vectors": [
    {
      "id": "DELEGATION-001",
      "name": "Delegation Must Not Be Counted as Operation",
      "description": "A delegation event MUST NOT be flattened into the calling agent Operation Count or Attempt Count.",
      "principle": "Delegation is not an Operation. Invariant 27.",
      "vectors": [
        {
          "id": "del-001a-separate-count",
          "description": "Delegation and Operation coexist in same task; delegation must not inflate operation count",
          "input": {
            "task_id": "t-1",
            "delegations": [
              {
                "delegation_id": "am-delegation-1",
                "delegating_caller": "agent-a",
                "called_agent": "agent-b",
                "called_capability": "agent:accept_subtask",
                "parent_task_id": "t-1",
                "depth": 0,
                "scope": "in_harness",
                "status": "completed",
                "observed_at": "2026-09-21T00:00:00Z"
              }
            ],
            "operations": [
              {
                "operation_id": "op-1",
                "capability": "file_read",
                "task_id": "t-1"
              },
              {
                "operation_id": "op-2",
                "capability": "code_search",
                "task_id": "t-1"
              }
            ]
          },
          "expect": {
            "delegation_count": 1,
            "operation_count": 2,
            "delegation_inflated_operation_count": false,
            "verdict": "PASS"
          }
        },
        {
          "id": "del-001b-flattened-misallowed",
          "description": "Implementation that merges delegation into operation count MUST FAIL",
          "input": {
            "task_id": "t-2",
            "delegations": [
              {
                "delegation_id": "am-delegation-2",
                "delegating_caller": "agent-a",
                "called_agent": "agent-b",
                "called_capability": "agent:accept_subtask",
                "parent_task_id": "t-2",
                "depth": 0,
                "scope": "in_harness",
                "status": "completed"
              }
            ],
            "operations": [
              {
                "operation_id": "op-3",
                "capability": "file_read",
                "task_id": "t-2"
              }
            ],
            "claimed_operation_count": 2,
            "correct_operation_count": 1
          },
          "expect": {
            "claimed_operation_count_matches": false,
            "verdict": "FAIL",
            "failure_reason": "Delegation MUST NOT be flattened into Operation Count (invariant 27)."
          }
        },
        {
          "id": "del-001c-zero-delegation",
          "description": "Task with no delegations returns zero delegation count",
          "input": {
            "task_id": "t-3",
            "delegations": [],
            "operations": [
              {
                "operation_id": "op-4",
                "capability": "search",
                "task_id": "t-3"
              }
            ]
          },
          "expect": {
            "delegation_count": 0,
            "operation_count": 1,
            "verdict": "PASS"
          }
        }
      ]
    },
    {
      "id": "DELEGATION-002",
      "name": "Delegation Depth DAG Enforcement",
      "description": "Delegation graph MUST be a DAG. Cyclic delegation (A->B->A) MUST be detected and rejected. Depth MUST be enforced with an implementation-defined upper bound (CORE §2.4, invariant 30).",
      "principle": "No cycles. Depth bounded. Invariant 30: Measurement graph MUST be a DAG.",
      "vectors": [
        {
          "id": "del-002a-acceptable-chain",
          "description": "A->B->C chain with depth 0,1 produces PASS - DAG integrity holds",
          "input": {
            "delegations": [
              {
                "delegation_id": "am-delegation-3",
                "delegating_caller": "agent-a",
                "called_agent": "agent-b",
                "depth": 0
              },
              {
                "delegation_id": "am-delegation-4",
                "delegating_caller": "agent-b",
                "called_agent": "agent-c",
                "depth": 1
              }
            ]
          },
          "expect": {
            "dag_integrity": true,
            "max_depth_observed": 1,
            "cycle_detected": false,
            "verdict": "PASS"
          }
        },
        {
          "id": "del-002b-cycle-rejection",
          "description": "A->B->A cycle MUST be rejected by the conformance checker",
          "input": {
            "delegations": [
              {
                "delegation_id": "am-delegation-5",
                "delegating_caller": "agent-a",
                "called_agent": "agent-b",
                "depth": 0
              },
              {
                "delegation_id": "am-delegation-6",
                "delegating_caller": "agent-b",
                "called_agent": "agent-a",
                "depth": 1
              }
            ]
          },
          "expect": {
            "dag_integrity": false,
            "cycle_detected": true,
            "verdict": "FAIL",
            "failure_reason": "Cyclic delegation detected: agent-a -> agent-b -> agent-a. MUST be rejected per invariant 30."
          }
        },
        {
          "id": "del-002c-depth-limit",
          "description": "Delegation at or beyond MAX_DELEGATION_DEPTH MUST be rejected or truncated",
          "input": {
            "delegations": [
              {
                "delegation_id": "am-delegation-7",
                "delegating_caller": "agent-a",
                "called_agent": "agent-b",
                "depth": 0
              },
              {
                "delegation_id": "am-delegation-8",
                "delegating_caller": "agent-b",
                "called_agent": "agent-c",
                "depth": 1
              },
              {
                "delegation_id": "am-delegation-9",
                "delegating_caller": "agent-c",
                "called_agent": "agent-d",
                "depth": 2
              }
            ],
            "max_delegation_depth": 2
          },
          "expect": {
            "dag_integrity": true,
            "depth_limit_enforced": false,
            "verdict": "FAIL",
            "failure_reason": "Depth 2 equals MAX_DELEGATION_DEPTH=2. Implementation MUST enforce depth < MAX_DEPTH or provide a clear bound."
          }
        }
      ]
    },
    {
      "id": "DELEGATION-003",
      "name": "Cross-Harness Delegation Cost Attribution",
      "description": "Sub-agent attempt costs belong to the attempt itself. Parent aggregation MUST be labeled 'aggregated'. Cross-harness delegation lineage must be preserved for cost tracing (CORE §2.4, invariants 28, 31).",
      "principle": "Cost belongs to the attempting agent. Cross-harness attribution is aggregated, never direct. Invariant 31: Sub-agent attempt cost belongs to that attempt. Parent aggregation MUST be labeled 'aggregated'.",
      "vectors": [
        {
          "id": "del-003a-parent-aggregates",
          "description": "Parent harness aggregates sub-agent costs with 'aggregated' label - PASS",
          "input": {
            "task_id": "t-10",
            "parent_harness_delegation": {
              "delegation_id": "am-delegation-10",
              "delegating_caller": "agent-a",
              "called_agent": "agent-b",
              "depth": 0,
              "scope": "cross_harness"
            },
            "parent_cost_report": {
              "total_cost": 0.05,
              "own_attempts_cost": 0.02,
              "aggregated_child_cost": 0.03,
              "aggregation_label": "aggregated"
            }
          },
          "expect": {
            "total_cost_accounted": true,
            "aggregation_labeled": true,
            "verdict": "PASS"
          }
        },
        {
          "id": "del-003b-no-double-count",
          "description": "Same attempt cost MUST NOT be counted in both parent and child harness - FAIL if duplicated",
          "input": {
            "attempt_cost": 0.03,
            "parent_harness": {
              "claimed_cost": 0.05,
              "own_cost": 0.02,
              "aggregated_child": 0.03
            },
            "child_harness": {
              "claimed_cost": 0.03
            }
          },
          "expect": {
            "unique_total_cost": 0.05,
            "parent_plus_child_total": 0.08,
            "double_count_detected": true,
            "verdict": "FAIL",
            "failure_reason": "Cost double-counted: child cost 0.03 appears in both parent and child harness without dedup. Invariant 31: cost belongs to the attempt itself, not to the delegating parent."
          }
        },
        {
          "id": "del-003c-lineage-trace",
          "description": "Cross-harness lineage must be preserved for cost tracing back to origin",
          "input": {
            "delegation_id": "am-delegation-11",
            "delegating_caller": "agent-a",
            "called_agent": "agent-b",
            "depth": 0,
            "scope": "cross_harness",
            "lineage": [
              "am-delegation-11"
            ],
            "child_ref": "session-abc",
            "child_session_attempts": [
              {
                "attempt_id": "att-1",
                "cost": 0.01,
                "operation_id": "op-10"
              },
              {
                "attempt_id": "att-2",
                "cost": 0.02,
                "operation_id": "op-11"
              }
            ],
            "aggregation_report": {
              "delegation_id": "am-delegation-11",
              "total_child_cost": 0.03,
              "lineage_trace": [
                {
                  "harness": "parent",
                  "depth": 0
                },
                {
                  "harness": "child",
                  "depth": 1,
                  "child_ref": "session-abc"
                }
              ]
            }
          },
          "expect": {
            "lineage_preserved": true,
            "cost_traceable": true,
            "aggregation_labeled": true,
            "verdict": "PASS"
          }
        }
      ]
    }
  ]
}