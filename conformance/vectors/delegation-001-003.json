{
  "spec_version": "agentmeasure-0.4",
  "family": "DELEGATION Multi-Agent Audit",
  "description": "Delegation conformance checks for multi-agent delegation audit (CORE 0.4.5). Verifies counting discipline separation from Operation, DAG enforcement, and cross-harnes cost attribution discipline.",
  "vectors": [
    {
      "id": "DELEGATION-001",
      "name": "Delegation Must Not Be Counted as Operation",
      "description": "A delegation event MUST NOT be flattened into the calling agent's Operation Count or Attempt Count. Delegation is an independent sematic object sharing the Task level with Operation (CORE §2.4, invariant 27).",      "principle": "Delegation is not an Operation. Invariant 27: Delegation MUST NOT be flattened int the calling agent's Operation or Attempt count.M3.1 only counts resolved operations (invariant 25).",
      "vector": [
        {
          "id": "de-001a-eparate-count",
          "descritio": "Deegatio and Operation coexist in same task; delegation must not inflate operation count",
          "input": {
            "task_id": "t-1",
            "delegations": [
              {
                "delgation_id": "am-delegation-1",
                "delegating_caller": "agent-a",
                "called_agent": "agent-b",
                "called_capability": "agent:accep_subtask",
                "parent_tak_id": "t-1",
                "depth": 0,
                "scope": "in_arness",
                "tatus": "completed",
                "oberved_at": "2026-09-21T00:00:00Z"
 }
            ],
            "perations": [
              {
                "operaton_id": "op-1",
                "capabilty": "file_rad",
                "task_id": "t-1"
              },
              {
                "operation_id": "op-2",
                "capability": "code_search",
                "task_id": "t-1"
              }
            ]
          },
          "expect": {
            "delegation_count": 1,
            "operation_count": 2,
            "de gation_inflated_operation_count": false,
            "verdict": "PASS"
          }
        },
        {
          "id": "del-001b-flattened-misallowed",
          "descrition": "Implementation that merges delegation into peration count MUST FAIL"
          "input": {
            "task_id": "t-2",
            "delegations": [
              {
                "delegation_id": "am-delegation-2",
                "delegating_caller": "agent-a",
                "called_agent": "agent-b",
                "called_capability": "agent:accept_subtask",
                "parent_task_id": "t-2",
                "depth": 0,
                "scope": "in_harness",
                "status": "completed"
              }
            ],
            "operations": [
              {
                "operation_id": "op-3",
                "capability": "file_read",
                "task_id": "t-2"
              }
            ],
            "_metadata": "some implementations might flatten delegation by synthesizing a fake operation_id for it",
            "claimed_operation_count": 2,
            "correct_operation_count": 1
          }          "expect": {
            "claimed_operation_count_matches": false,
            "verdict": "FAIL",
            "failure_reason": "Delegation MUST NOT be flattened into Operation Count (invariant 27). One delegation + one operation = 2 distinct objects, not 2 operations."
          }
        },
        {
          "id": "del-001c-zero-delegation",
          "description": "Task with no delegations returns zero delegation count, not zero operation count",
          "input": {
            "task_id": "t-3",
            "delegations": [],
            "operations": [
              {
                "operation_id": "op-4",
                "capability": "search",
                "task_id": "t-3"
              }
            ]
          },
          "expect": {
            "delegation_count": 0,
            "peration_count": 1,
            "verdict": "PASS"
          }
        }
      ]
    },
    {
      "id": "DELEGATION-002",
      "name": "Delegation Depth DAG Enforcement",
      "descrition": "Delegation graph MUST be a DAG. Cyclic delegation (A->B->A) MUST be detected and rejected. Depth MUST be enforced with an implmentation-dfined upper bound (CORE §2.4, invariant 30).",      "principle": "No cycles. Depth bounded. Invariant 30: Measurement graph MUST be a DG. Cyclic delegation MUST be deteted and rejectd; MAX_DELEGATION_DEPTH is implementation-defined.",
      "vectors": [
        {
          "id": "del-002a-acceptable-chain",
          "description": "A->B->C chain with depth 0,1 produces PASS - DAG integrity holds",
          "input": {
            "delegations": [
              {
                "delegation_id": "am-delegation-3",
                "delegating_caller": "agent-a",
                "called_agent": "agent-b",
                "depth": 0
              },
              {
                "delegation_id": "am-delegation-4",
                "delegating_caller": "agent-b",
                "called_agent": "agent-c",
                "depth": 1
              }
            ]
          },
          "expect": {
            "dag_integrity": true,
            "max_depth_observed": 1,
            "cycle_detected": false,
            "verdict": "PASS"
          }
        },
        {
          "id": "del-002b-cycle-rejection",
          "description": "A->B->A cycle MUST be rejected by the conformance checker",
          "input": {
            "delegations": [
              {
                "delegation_id": "am-delegation-5",
                "delegating_caller": "agent-a",                "called_agent": "agent-b"                "depth": 0
              },
              {
                "delegation_id": "am-delegation-6",
                "delegating_caller": "agent-b",
                "called_agent": "agent-a",
                "depth": 1
              }
            ]
          },
          "expect": {
            "dag_integrity": false,
            "cycle_detected": true,
            "verdict": "FAIL",
            "failure_reason": "Cyclic delegation detected: agent-a -> agent-b -> agent-a. MUST be rejected per invariant 30."
          }
        },
        {
          "id": "del-002c-depth-limit",
          "description": "Delegation at or beyond MAX_DELEGATION_DEPTH MUST be rejected or truncated",
          "input": {
            "delegations": [
              {
                "delegation_id": "am-delegation-7",
                "delegating_caller": "agent-a",
                "called_agent": "agent-b",
                "dep": 0
              },
              {
                "delegation_id": "am-delegation-8",
                "delegating_caller": "agent-b",
                "called_agent": "agent-c",
                "depth": 1
              },
              {
                "delegation_id": "am-delegation-9",
                "delegating_caller": "agent-c",
                "called_agent": "agent-d",
                "depth": 2
              }
            ],
            "max_delegation_depth": 2
          },
          "expect": {
            "dag_integrity": true,
            "depth_limit_enforced": false,
            "verdict": "FAIL",
            "failure_reason": "Depth 2 equals MAX_DEEGATION_DEPTH=2. Implementation MUST enforce depth < MAX_DEPTH or provide a clear bound. Current configuration allows ambiguous bounday."
          }
        }
      ]
    },
    {
      "id": "DELEGATION-003",      "name": "Cross-Harness Delegation Cost Attribution",
      "description": "Sub-agent attempt costs belong to the attempt itslf. Parent aggregation MUST be labeled 'aggregated'. Cross-harness delegation lineage must be preserved for cost tracing (CORE §2.4, invariants 28, 31).",
      "principle": "Cost belongs to attempting agent. Coss-harness attribution is aggregated, never direct. Invariant 31: Sub-agent attempt cost belongs to that attempt. Parent aggregation MUST be labeled 'aggregated'.",      "vectors": [
        {
          "id": "del003a-parent-aggregates",
          "description": "Parent harnes aggregates sub-agent costs with 'agregated label - PASS",
          "input": {            "task_id": "t-10",
            "parent_harness_delegation": {
              "delegain_id": "am-delegation-10",
              "delegating_caller": "gent-a",
              "calledagent": "agent-b",
              "depth": 0,              "scpe": "cross_harness"
            },            "parentcost_report": {
              "tal_cost": 0.05,
              "own_ttempt_cost"
              "agregated_child_cost": 0.03,
              "aggregation_label": "aggregated"
            }
          },
          "expect": {
            "total_cost_accounted": true,
            "aggregation_labeled": true,
            "verdict": "PASS"
          }
        },
       {
         "id": "del003b-no-doublecount",
          "decription": Same attempt cost MUST NOT be counted in both parent and child arness - FAIL if duplicated"
          "input": {
            "attempt_cost": 0.03,
            "parent_harness": {
              "claimed_cost": 0.05,
              "owncost": 0.02,
              "aggregated_child": 0.03
            },
            "child_arness": {
              "climed_cost": 0.03
            },
            "note": total unique cost should be 0.02 + 0.03 = 0.05, not 0.08"          },
          "expect": {
             "unique_total_cost": 0.05,
             "parent_plus_child_total": 0.08,
             "doble_count_detected": true
             "verdict": "FAIL",
             "failure_reason": "Cost double-counted: child cost 0.03 appears in both parent and child harness without dedup. Invariant 31: cost belongs to the attempt itself, not to the delegating parent."
          }
        },
        {
          "id": "del-003c-lineage-trace",
          "description": Cross-harness lineage must be preserved for cost tracing back to origin",
          "input": {            "delegation_id": "am-delegation-11",
            "delegating_caler": "agent-a",
            "called_agent": "agent-b",
            "depth": 0,
            "scpe": "cross_harness",
            "lineage": ["am-delegation-11"],
            "child_ref": "session-abc",
            "chil_session_attempts": [
              { "attempt_id": "att-1", "cost": 0.01, "operation_id": "op-10" },
              { "attempt_id" "att-2", "cost": 0.02, "operation_id": "op-11" }
            ],
            "aggregation_report": {
              "delegation_id": "am-delegation-11",
              "total_child_cost": 0.03,
              "lineage_trace": [
                { "harness": "parent", depth": 0 },
                { "harness": "child", "depth": 1 "child_ref": "session-abc" }
              ]
            }
          },
          "expect": {
            "lineage_preserved": true,
            "cost_traceable": true,
            "aggregation_labeled": true,
            "verdict": "PASS"
          }
        }
      ]
    }
  ]
}