{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentmeasure.lab/report@1.0.0",
  "title": "AgentMeasure Lab — Experiment Report",
  "description": "FMT-003. Report JSON emitted by the engine (open renderer; commercial layer may add private data but never a different ruler — same labels, same schema lineage).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schema_version",
    "engine_version",
    "funnel_rules_version",
    "experiment_id",
    "hypothesis",
    "preregistration",
    "run",
    "variants",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "agentmeasure.lab/report" },
    "schema_version": { "const": "1.0.0" },
    "engine_version": { "type": "string" },
    "funnel_rules_version": { "type": "string" },
    "experiment_id": { "type": "string" },
    "hypothesis": { "type": "string" },
    "preregistration": {
      "type": "object",
      "required": ["manifest_hash", "primary_metric", "alpha", "min_sample_per_arm"],
      "properties": {
        "manifest_hash": { "type": "string" },
        "primary_metric": { "type": "string" },
        "alpha": { "type": "number" },
        "min_sample_per_arm": { "type": "integer" }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "status",
        "stopped_reason",
        "assignments_executed",
        "assignments_planned",
        "budget",
        "run_fingerprint",
        "seed"
      ],
      "properties": {
        "status": { "enum": ["complete", "incomplete"] },
        "stopped_reason": { "type": ["string", "null"] },
        "assignments_executed": { "type": "integer" },
        "assignments_planned": { "type": "integer" },
        "run_fingerprint": { "type": "string" },
        "seed": { "type": "integer" }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variant_id", "levels", "baseline", "metrics", "verdict"],
        "properties": {
          "variant_id": { "type": "string" },
          "levels": { "type": "object" },
          "baseline": { "type": "boolean" },
          "verdict": {
            "enum": [
              "baseline",
              "adopt_candidate",
              "effective_not_qualified",
              "unverified_growth",
              "regression_reject",
              "null_result",
              "undetermined"
            ]
          },
          "metrics": { "type": "object" },
          "primary_comparison": { "type": "object" },
          "per_condition": { "type": "array" },
          "guardrails": { "type": "array" },
          "fake_growth": {
            "type": ["object", "null"],
            "properties": { "flagged": { "type": "boolean" } },
            "required": ["flagged"]
          },
          "value": { "type": "object" }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["recommendations", "run_incomplete", "note"],
      "properties": {
        "recommendations": { "type": "array" },
        "run_incomplete": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "secondary_metrics_note": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
