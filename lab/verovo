#!/usr/bin/env python3
"""`am` — Verovo CLI entry point.

Usage (from the repository root):
    python3 lab/verovo lab init
    python3 lab/verovo lab preregister verovo-lab/experiments/example-manifest.json
    python3 lab/verovo lab run verovo-lab/experiments/example-manifest.prereg.json
    python3 lab/verovo lab verify <run-dir> <prereg-file>

Zero dependencies, fully offline, no registration.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from verovo_lab.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
