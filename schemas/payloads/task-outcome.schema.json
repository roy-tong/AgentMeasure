{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "payload: task_outcome",
  "type": "object",
  "required": [
    "task_id",
    "task_success"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "task_success": {
      "type": "boolean"
    },
    "attempt_count": {
      "type": "integer",
      "description": "Optional declared attempt count; the aggregator reconciles it against attempt rows (#9), never trusts it."
    },
    "model": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
