        "statement section 5"
      ]
    },
    {
      "id": "S-7",
      "title": "Free tooling, open governance",
      "adopted_from": "AM positioning",
      "enforced_by": [
        "GOVERNANCE.md",
        "LICENSE"
      ]
    },
    {
      "id": "S-8",
      "title": "Clause change updates its test first",
      "adopted_from": "ARS-1 blind-reader isomorph",
      "enforced_by": [
        "GOVERNANCE.md process"
      ]
